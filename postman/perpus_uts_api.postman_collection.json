    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Summary Statistik",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response envelope is valid\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.statusCode).to.eql(200);",
                  "  pm.expect(json.data).to.be.an(\"object\");",
                  "});",
                  "pm.test(\"Summary contains required library metrics\", () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property(\"totalTitles\");",
                  "  pm.expect(data).to.have.property(\"totalCopies\");",
                  "  pm.expect(data).to.have.property(\"availableCopies\");",
                  "  pm.expect(data).to.have.property(\"activeLoans\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "summary"
              ]
            }
          }
        }
      ]
    },
