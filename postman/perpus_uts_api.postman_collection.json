            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Detail matches bookId\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.id).to.eql(pm.collectionVariables.get(\"bookId\"));",
                  "});",
                  "const etag = pm.response.headers.get('ETag');",
                  "if (etag) { pm.collectionVariables.set('bookETag', etag); }",
                  "pm.test('Response includes Strong ETag header', function () {",
                  "    pm.expect(etag).to.be.a('string');",
                  "    pm.expect(etag.startsWith('W/')).to.be.false;",
                  "});"
