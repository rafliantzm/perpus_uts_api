                  "pm.test(\"Response has paginated envelope\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(Array.isArray(json.data)).to.be.true;",
                  "  pm.expect(json.meta).to.have.property(\"total\");",
                  "});",
                  "pm.test(\"ETag header is present\", () => {",
                  "  pm.expect(pm.response.headers.has(\"ETag\")).to.be.true;",
