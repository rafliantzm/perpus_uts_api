        {
          "name": "Delete Member",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Buat anggota sementara untuk pengujian penghapusan",
                  "const baseUrl = pm.variables.get(\"baseUrl\") || pm.collectionVariables.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/members\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\", \"Accept\": \"application/json\" },",
                  "  body: {",
                  "    mode: \"raw\",",
                  "    raw: JSON.stringify({",
                  "      name: \"Anggota Uji Hapus \" + Date.now(),",
                  "      nim: \"DEL\" + Date.now().toString().slice(-7)",
                  "    })",
                  "  }",
                  "}, function (err, res) {",
                  "  if (!err && res.json() && res.json().data) {",
                  "    pm.collectionVariables.set(\"memberToDeleteId\", res.json().data.id);",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Member successfully deleted\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/members/{{memberToDeleteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberToDeleteId}}"
              ]
            }
          }
        }
      ]
