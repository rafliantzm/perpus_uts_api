        {
          "name": "Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set(\"bookId\", res.data.id);",
                  "}",
                  "pm.test(\"Status code is 201 Created\", () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Book created with equal total and available copies\", () => {",
                  "  pm.expect(res.success).to.be.true;",
                  "  pm.expect(res.data.availableCopies).to.eql(res.data.totalCopies);",
                  "  pm.expect(res.data.id).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Architecture: A Craftsman's Guide\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"978-0134494166\",\n  \"totalCopies\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
