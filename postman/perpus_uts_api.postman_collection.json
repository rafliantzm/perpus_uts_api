        {
          "name": "Delete Book",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Buat buku sementara untuk pengujian penghapusan",
                  "const baseUrl = pm.variables.get(\"baseUrl\") || pm.collectionVariables.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/books\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\", \"Accept\": \"application/json\" },",
                  "  body: {",
                  "    mode: \"raw\",",
                  "    raw: JSON.stringify({",
                  "      title: \"Buku Uji Hapus \" + Date.now(),",
                  "      author: \"Penulis Hapus\",",
                  "      totalCopies: 1",
                  "    })",
                  "  }",
                  "}, function (err, res) {",
                  "  if (!err && res.json() && res.json().data) {",
                  "    pm.collectionVariables.set(\"bookToDeleteId\", res.json().data.id);",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Book successfully deleted\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookToDeleteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookToDeleteId}}"
              ]
            }
          }
        }
      ]
