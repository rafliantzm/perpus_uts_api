{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/books": {
      "post": {
        "operationId": "BooksController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Buku berhasil ditambahkan"
          },
          "400": {
            "description": "Payload tidak valid"
          }
        },
        "summary": "Menambahkan buku baru ke katalog perpustakaan",
        "tags": [
          "Books"
        ]
      },
      "get": {
        "operationId": "BooksController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Nomor halaman",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Jumlah item per halaman",
            "schema": {
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Kata kunci pencarian",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Kolom untuk pengurutan data",
            "schema": {
              "default": "createdAt",
              "type": "string"
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "description": "Arah pengurutan data (ASC atau DESC)",
            "schema": {
              "default": "DESC",
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar buku berhasil diambil"
          },
          "400": {
            "description": "Parameter kueri sortBy atau order tidak valid"
          }
        },
        "summary": "Mendapatkan daftar buku (dengan pagination, search, dan sorting)",
        "tags": [
          "Books"
        ]
      }
    },
    "/api/v1/books/{id}": {
      "get": {
        "operationId": "BooksController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID Buku (UUID)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail buku berhasil diambil"
          },
          "404": {
            "description": "Buku tidak ditemukan"
          }
        },
        "summary": "Mendapatkan detail buku berdasarkan ID (UUID)",
        "tags": [
          "Books"
        ]
      },
      "put": {
        "operationId": "BooksController_updateFull",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID Buku (UUID)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "if-match",
            "required": false,
            "in": "header",
            "description": "Strong ETag validator untuk optimistic concurrency control",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBookDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data buku berhasil diperbarui"
          },
          "400": {
            "description": "Payload tidak valid atau konflik stok"
          },
          "404": {
            "description": "Buku tidak ditemukan"
          },
          "412": {
            "description": "Precondition Failed - ETag usang atau tidak cocok"
          }
        },
        "summary": "Memperbarui seluruh data buku (dengan dukungan If-Match)",
        "tags": [
          "Books"
        ]
      },
      "patch": {
        "operationId": "BooksController_updatePartial",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID Buku (UUID)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "if-match",
            "required": false,
            "in": "header",
            "description": "Strong ETag validator untuk optimistic concurrency control",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBookDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data buku berhasil diperbarui"
          },
          "404": {
            "description": "Buku tidak ditemukan"
          },
          "412": {
            "description": "Precondition Failed - ETag usang atau tidak cocok"
          }
        },
        "summary": "Memperbarui sebagian data buku (dengan dukungan If-Match)",
        "tags": [
          "Books"
        ]
      },
      "delete": {
        "operationId": "BooksController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID Buku (UUID)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Buku berhasil dihapus"
          },
          "400": {
            "description": "Buku tidak bisa dihapus karena masih ada peminjaman aktif"
          },
          "404": {
            "description": "Buku tidak ditemukan"
          }
        },
        "summary": "Menghapus buku dari katalog",
        "tags": [
          "Books"
        ]
      }
    },
    "/api/v1/members": {
      "post": {
        "operationId": "MembersController_create",
