            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail anggota berhasil diambil"
          },
          "404": {
            "description": "Anggota tidak ditemukan"
          }
        },
        "summary": "Mendapatkan detail anggota beserta riwayat peminjaman",
        "tags": [
          "Members"
        ]
      },
      "put": {
        "operationId": "MembersController_updateFull",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID Anggota (UUID)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "if-match",
            "required": false,
            "in": "header",
