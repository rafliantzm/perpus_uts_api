          "400": {
            "description": "Parameter kueri sortBy atau order tidak valid"
          }
        },
        "summary": "Mendapatkan daftar anggota (dengan pagination, search, dan sorting)",
        "tags": [
          "Members"
        ]
      }
    },
    "/api/v1/members/{id}": {
      "get": {
        "operationId": "MembersController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
